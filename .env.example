MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── SMS ───────────────────────────────────────────────────────────────────
# Master switch for every outgoing SMS (OTP + appointment reminders).
# false = nothing is sent, and the OTP endpoints keep returning the code in
#         their JSON response so the flow stays testable.
# true  = codes go out by SMS and are NO LONGER exposed over the API.
SMS_ENABLED=false

# Which gateway delivers the message: seven | vonage | log
#   seven  = seven.io (current provider)
#   vonage = the previous provider, kept as a one-line fallback
#   log    = write to the log instead of sending (local development)
SMS_DRIVER=seven

# Country code (digits only, no "+") used for numbers typed in national format
# with a single leading zero, e.g. 0501010101 -> +971501010101.
# Leave empty to pass such numbers through untouched.
SMS_DEFAULT_COUNTRY_CODE=

# ── seven.io ──────────────────────────────────────────────────────────────
# Create the API key at https://dashboard.seven.io/developer/api
SEVEN_API_KEY=
# Sender ID: max 11 alphanumeric characters (or 16 numeric). A longer value is
# rejected by the gateway with code 201. Leave empty to use the account default
# sender number, which is safer in countries that block unregistered alpha IDs.
SEVEN_FROM=Barber
SEVEN_BASE_URL=https://gateway.seven.io/api
# Message validity in minutes. Empty = gateway default (48h). The OTP path
# overrides this with the code's own lifetime.
SEVEN_TTL=
# Optional statistics label shown in the seven.io dashboard.
SEVEN_LABEL=
# Dry run: seven.io validates and prices the message but never sends it and
# never charges for it. Useful on staging.
SEVEN_DEBUG=false
SEVEN_TIMEOUT=15

# ── Vonage (legacy fallback — only used when SMS_DRIVER=vonage) ────────────
VONAGE_SMS_ENABLED=false
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_FROM=BarberBooking
VONAGE_BASE_URL=https://rest.nexmo.com

# Fiskaly Configuration
# Master switch for the whole German TSE integration.
# false = no Fiskaly API calls anywhere, and no TSE QR code on printed receipts.
# Set to true once the real TSS/Client credentials below are in place.
FISKALY_ENABLED=false
# Get your API credentials from https://dashboard.fiskaly.com

# API Credentials (REQUIRED)
FISKALY_API_KEY=test_9843uwcqk0h5ij8pvcin4jal6_test
FISKALY_API_SECRET=6D7dD2Q6x7lZk2gkzahmpCIH36yFytnlCLYRJZm08Cx

# Environment (test or production)
FISKALY_ENVIRONMENT=test

# API Base URL (usually no need to change)
FISKALY_BASE_URL=https://kassensichv.fiskaly.com/api/v2

# Organization ID (from Fiskaly Dashboard)
FISKALY_ORGANIZATION_ID=9bd3f40b-4dda-4c0f-a6ba-61e98bd61c5a


# TSS Configuration (will be auto-filled by setup command)
FISKALY_TSS_ID=
FISKALY_TSS_DESCRIPTION="Main TSS for Beauty Salon"
FISKALY_TSS_PUK=
FISKALY_TSS_ADMIN_PIN=

# Client Configuration (will be auto-filled by setup command)
FISKALY_CLIENT_ID=
FISKALY_CLIENT_SERIAL=SALON-POS-001

# Business Information (for receipts)
FISKALY_BUSINESS_NAME="Beauty Salon"
FISKALY_BUSINESS_ADDRESS="Musterstraße 123, 10115 Berlin"
FISKALY_TAX_NUMBER=
FISKALY_VAT_NUMBER=

# Logging
FISKALY_LOGGING_ENABLED=true
FISKALY_LOG_CHANNEL=daily
FISKALY_LOG_LEVEL=info

# Offline Mode
FISKALY_OFFLINE_MODE_ENABLED=true

# Staff Dashboard host.
# Empty/unset = served at <APP_URL>/dashboard (local default).
# Set to a bare hostname (e.g. dashboard.lookupfriseur.com) to serve it at that
# subdomain root instead. Routes are registered once either way.
#
# Leave this EMPTY in local development. Pointing it at a production subdomain
# while APP_URL is 127.0.0.1 makes route('staff.dashboard') resolve to a host the
# dev machine cannot reach — and because StaffLoginResponse sends providers (and
# only providers) there after login, the symptom looks like "the provider cannot
# log in" rather than a misconfigured domain.
#
# When this IS a subdomain, set SESSION_DOMAIN to the shared parent (.example.com)
# if one sign-in should serve both /admin and the dashboard and one sign-out
# should end both. Without it each host keeps its own session: the dashboard
# still works on its own (it authenticates on its own host — see
# App\Http\Controllers\Auth\StaffAuthController) but crossing to /admin asks for
# a fresh login.
STAFF_DASHBOARD_DOMAIN=
